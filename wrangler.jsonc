{
  // Cloudflare Workers Static Assets, deployed with `npm run deploy` or from GitHub Actions.
  // Static Assets applies public/_headers (CSP, HSTS, etc.).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frigocalc",
  // Served from the account's workers.dev subdomain (frioeclima.workers.dev).
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": false }
}
