{
  // Cloudflare Workers (Static Assets) — publicação por `npm run deploy` ou via GitHub Actions.
  // O arquivo public/_headers é respeitado pelos Static Assets (CSP, HSTS etc.).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frigocalc",
  // workers.dev and preview URLs stay off for now.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": false }
}
